[
  {
    "id": "late-arrival",
    "title": "An older version arrives late",
    "description": "T1 version 1 arrives after version 2. Arrival order must not override business version.",
    "events": [
      {
        "source": "SIM",
        "trade_id": "T1",
        "version": 1,
        "arrival_seq": 1,
        "status": "ACTIVE",
        "notional_minor": 10000,
        "currency": "USD"
      },
      {
        "source": "SIM",
        "trade_id": "T1",
        "version": 2,
        "arrival_seq": 2,
        "status": "ACTIVE",
        "notional_minor": 12000,
        "currency": "USD"
      },
      {
        "source": "SIM",
        "trade_id": "T1",
        "version": 1,
        "arrival_seq": 3,
        "status": "ACTIVE",
        "notional_minor": 10000,
        "currency": "USD"
      }
    ],
    "expected": {
      "latest": [
        {
          "source": "SIM",
          "trade_id": "T1",
          "version": 2,
          "status": "ACTIVE",
          "notional_minor": 12000,
          "currency": "USD"
        }
      ],
      "active": [
        {
          "source": "SIM",
          "trade_id": "T1",
          "version": 2,
          "status": "ACTIVE",
          "notional_minor": 12000,
          "currency": "USD"
        }
      ],
      "quarantined": [],
      "conflicting_keys": [],
      "input_records": 3,
      "distinct_event_keys": 2,
      "replay_records": 1
    },
    "expected_packet": {
      "source": "SIM",
      "trade_id": "T1",
      "serving_eligible": true,
      "reason": "Validated latest state; a cancellation must not be described as active.",
      "evidence": {
        "source": "SIM",
        "trade_id": "T1",
        "version": 2,
        "status": "ACTIVE",
        "notional_minor": 12000,
        "currency": "USD"
      }
    }
  },
